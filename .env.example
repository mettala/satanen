# Two local files, both git-ignored. Copy the matching part of this file into each.
#
# 1) .env  (PUBLIC settings only). Expo copies everything in .env that starts with
#    EXPO_PUBLIC_ into the app, so never put a key or token in this file.
#    `npm run build:web` fails if any other EXPO_PUBLIC_ name ends up in dist/.
# Where the app finds the proxy. Local dev: the Worker's dev URL.
EXPO_PUBLIC_PROXY_URL=http://localhost:8787

# 2) .env.fixtures  (SECRETS; Expo does not load this file).
# Yle keys for `npm run fetch-fixtures`. Get them from https://developer.yle.fi (needs Yle Tunnus).
# The dev proxy reads its own copy in proxy/.dev.vars (see proxy/.dev.vars.example).
YLE_APP_ID=
YLE_APP_KEY=

# Only for `npm --prefix proxy run stats` (D32): reading the page counts.
# Account id: Cloudflare dashboard, right-hand side of the account home page.
# Token: My Profile > API Tokens > Create Token > Custom token, one permission only:
# Account > Account Analytics > Read. (Not named CLOUDFLARE_API_TOKEN, so Wrangler never uses it.)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ANALYTICS_TOKEN=
