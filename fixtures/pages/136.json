       "line": [
        {
         "number": "1",
         "Text": "   ULKOMAAT        YLE  KESKIVIIKKO     "
        },
        {
         "number": "2"
        },
        {
         "number": "3",
         "Text": "  Putin valmis neuvotteluihin           "
        },
        {
         "number": "4"
        },
        {
         "number": "5"
        },
        {
         "number": "6",
         "Text": " Venäjän presidentti Vladimir Putin     "
        },
        {
         "number": "7",
         "Text": " sanoo olevansa periaatteessa valmis    "
        },
        {
         "number": "8",
         "Text": " aloittamaan uudelleen Ukrainan         "
        },
        {
         "number": "9",
         "Text": " rauhanneuvottelut marraskuun           "
        },
        {
         "number": "10",
         "Text": " puolessavälissä.                       "
        },
        {
         "number": "11"
        },
        {
         "number": "12",
         "Text": " Asiasta kertoi Kremlin tiedottaja Juri "
        },
        {
         "number": "13",
         "Text": " Ushakov. Ushakovin mukaan neuvotteluiss"
        },
        {
         "number": "14",
         "Text": " pitäisi keskustella Ukrainan ja        "
        },
        {
         "number": "15",
         "Text": " Venäjän sodan jälkeisistä              "
        },
        {
         "number": "16",
         "Text": " turvatakuista.                         "
        },
        {
         "number": "17"
        },
        {
         "number": "18",
         "Text": " Neuvotteluissa olisivat mukana         "
        },
        {
         "number": "19",
         "Text": " Ukraina, Venäjä ja Yhdysvallat.        "
        },
        {
         "number": "20"
        },
        {
         "number": "21",
         "Text": " Tällaisia neuvotteluja ei ole käyty    "
        },
        {
         "number": "22",
         "Text": " sitten helmikuun.                      "
        },
        {
         "number": "23"
        },
        {
         "number": "24"
        }
       ]
