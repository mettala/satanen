        {
         "number": "1",
         "Text": "   KOTIMAA         YLE  KESKIVIIKKO     "
        },
        {
         "number": "2"
        },
        {
         "number": "3",
         "Text": "  Yksi kuoli Jyväskylän palossa         "
        },
        {
         "number": "4"
        },
        {
         "number": "5"
        },
        {
         "number": "6",
         "Text": " Jyväskylässä Hämeenkadulla             "
        },
        {
         "number": "7",
         "Text": " tapahtuneessa kerrostalopalossa on     "
        },
        {
         "number": "8",
         "Text": " kuollut yksi mies. Neljä ihmistä on    "
        },
        {
         "number": "9",
         "Text": " toimitettu sairaalaan, kertoo          "
        },
        {
         "number": "10",
         "Text": " Keski-Suomen pelastuslaitos.           "
        },
        {
         "number": "11"
        },
        {
         "number": "12",
         "Text": " Ensihoito tarkasti paikan päällä 16    "
        },
        {
         "number": "13",
         "Text": " ihmistä, joista neljä lähti            "
        },
        {
         "number": "14",
         "Text": " jatkotutkimuksiin.                     "
        },
        {
         "number": "15"
        },
        {
         "number": "16",
         "Text": " Palo sattui yhdessä huoneistossa, ja   "
        },
        {
         "number": "17",
         "Text": " savu levisi porraskäytävään ja muihin  "
        },
        {
         "number": "18",
         "Text": " asuntoihin. Päivystävän palomestarin   "
        },
        {
         "number": "19",
         "Text": " mukaan vaaraan joutuivat erityisesti   "
        },
        {
         "number": "20",
         "Text": " porraskäytävään paenneet.              "
        },
        {
         "number": "21"
        },
        {
         "number": "22",
         "Text": " Pelastuslaitos sai hälytyksen hieman   "
        },
        {
         "number": "23",
         "Text": " ennen iltaseitsemää kerrostaloon.      "
        },
        {
         "number": "24"
        }
       ]
      },
