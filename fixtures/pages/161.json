       "line": [
        {
         "number": "1",
         "Text": "   TALOUS          YLE  KESKIVIIKKO     "
        },
        {
         "number": "2"
        },
        {
         "number": "3",
         "Text": "  Netflixin osake laskussa              "
        },
        {
         "number": "4"
        },
        {
         "number": "5"
        },
        {
         "number": "6",
         "Text": " Suoratoistopalvelu Netflixin osakkeen  "
        },
        {
         "number": "7",
         "Text": " arvo lähti usean prosentin laskuun     "
        },
        {
         "number": "8",
         "Text": " sen jälkeen, kun yhtiö julkisti        "
        },
        {
         "number": "9",
         "Text": " heinä-syyskuun tuloksensa.             "
        },
        {
         "number": "10"
        },
        {
         "number": "11",
         "Text": " Yhtiön liikevaihto oli noin 12,9       "
        },
        {
         "number": "12",
         "Text": " miljardia dollaria. Nousua oli noin    "
        },
        {
         "number": "13",
         "Text": " 12 prosenttia verrattuna vastaavaan    "
        },
        {
         "number": "14",
         "Text": " ajanjaksoon vuotta aiemmin. Yhtiön     "
        },
        {
         "number": "15",
         "Text": " kokonaistulos oli noin 3,7 miljardia   "
        },
        {
         "number": "16",
         "Text": " dollaria. Tulos kasvoi vuoden          "
        },
        {
         "number": "17",
         "Text": " takaisesta noin 44 prosenttia.         "
        },
        {
         "number": "18"
        },
        {
         "number": "19",
         "Text": " Kasvusta huolimatta tuore neljännes-   "
        },
        {
         "number": "20",
         "Text": " vuosikatsaus ei hälventänyt            "
        },
        {
         "number": "21",
         "Text": " sijoittajien huolia katsojien          "
        },
        {
         "number": "22",
         "Text": " aktiivisuuden vähentymisestä ja        "
        },
        {
         "number": "23",
         "Text": " liikevaihdon kasvun hidastumisesta.    "
        },
        {
         "number": "24"
        }
       ]
      },
