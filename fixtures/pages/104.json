       "type": "text",
       "line": [
        {
         "number": "1",
         "Text": "   KOTIMAA         YLE  KESKIVIIKKO     "
        },
        {
         "number": "2"
        },
        {
         "number": "3",
         "Text": "  Auto törmäsi tolppaan Limingassa      "
        },
        {
         "number": "4"
        },
        {
         "number": "5"
        },
        {
         "number": "6",
         "Text": " Limingassa neljä ihmistä loukkaantui   "
        },
        {
         "number": "7",
         "Text": " vakavasti, kun henkilöauto törmäsi     "
        },
        {
         "number": "8",
         "Text": " liikenneopasteen tolppaan myöhään      "
        },
        {
         "number": "9",
         "Text": " tiistaina. Asiasta kertoo              "
        },
        {
         "number": "10",
         "Text": " Pohjois-Pohjanmaan pelastuslaitos.     "
        },
        {
         "number": "11"
        },
        {
         "number": "12",
         "Text": " Oulun poliisin mukaan henkilöauto      "
        },
        {
         "number": "13",
         "Text": " törmäsi pylvääseen kovalla nopeudella. "
        },
        {
         "number": "14",
         "Text": " Poliisi epäilee alkoholilla olleen     "
        },
        {
         "number": "15",
         "Text": " osuutta turmaan.                       "
        },
        {
         "number": "16"
        },
        {
         "number": "17",
         "Text": " Nelostiellä Jyväskylän suunnasta       "
        },
        {
         "number": "18",
         "Text": " kulkeneessa autossa oli kyydissä viisi "
        },
        {
         "number": "19",
         "Text": " ihmistä. Pelastuslaitos irrotti kaksi  "
        },
        {
         "number": "20",
         "Text": " ihmistä autosta sekä avusti ensihoitoa "
        },
        {
         "number": "21",
         "Text": " muiden loukkaantuneiden siirtämisessä. "
        },
        {
         "number": "22",
         "Text": " Poliisin mukaan kaikki kyydissä olleet "
        },
        {
         "number": "23",
         "Text": " loukkaantuivat.                        "
        },
        {
         "number": "24"
        }
       ]
      },
