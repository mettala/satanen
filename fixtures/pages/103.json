       "line": [
        {
         "number": "1",
         "Text": "   KOTIMAA         YLE  KESKIVIIKKO     "
        },
        {
         "number": "2"
        },
        {
         "number": "3",
         "Text": "  Etelässä odotetaan lämpenemistä       "
        },
        {
         "number": "4"
        },
        {
         "number": "5"
        },
        {
         "number": "6",
         "Text": " Keskiviikkona aamulla liikenteessä     "
        },
        {
         "number": "7",
         "Text": " kannattaa olla tarkkana: huonosta      "
        },
        {
         "number": "8",
         "Text": " ajokelistä varoitetaan maan itäosassa  "
        },
        {
         "number": "9",
         "Text": " sekä Uudenmaan, Päijät-Hämeen ja       "
        },
        {
         "number": "10",
         "Text": " Keski-Suomen maakunnissa kuuraisten    "
        },
        {
         "number": "11",
         "Text": " teiden vuoksi.                         "
        },
        {
         "number": "12"
        },
        {
         "number": "13",
         "Text": " Iltapäivä tarjoaa monin paikoin        "
        },
        {
         "number": "14",
         "Text": " aurinkoa, mutta lännessä ja Lapissa    "
        },
        {
         "number": "15",
         "Text": " pilvisyys on runsaampaa. Lämpötilat    "
        },
        {
         "number": "16",
         "Text": " jäävät koko maassa aivan etelää lukuun "
        },
        {
         "number": "17",
         "Text": " ottamatta alle 10 asteeseen. Lähestyvä "
        },
        {
         "number": "18",
         "Text": " matalapaine alkaa voimistaa tuulia     "
        },
        {
         "number": "19",
         "Text": " Pohjois-Lapissa ja merialueilla.       "
        },
        {
         "number": "20"
        },
        {
         "number": "21",
         "Text": " Illalla sää selkenee lähes koko        "
        },
        {
         "number": "22",
         "Text": " maassa, ja lämpötilat laskevat niin    "
        },
        {
         "number": "23",
         "Text": " ikään laajalti alle viiden asteen.     "
        },
        {
         "number": "24"
        }
       ]
      },
