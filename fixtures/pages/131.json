       "line": [
        {
         "number": "1",
         "Text": "   ULKOMAAT        YLE  KESKIVIIKKO     "
        },
        {
         "number": "2"
        },
        {
         "number": "3",
         "Text": "  Witkoff tapasi Putinin                "
        },
        {
         "number": "4"
        },
        {
         "number": "5"
        },
        {
         "number": "6",
         "Text": " Yhdysvaltojen erityislähettiläs Steve  "
        },
        {
         "number": "7",
         "Text": " Witkoff on tavannut keskiviikkona      "
        },
        {
         "number": "8",
         "Text": " Venäjän presidentin Vladimir Putin.    "
        },
        {
         "number": "9"
        },
        {
         "number": "10",
         "Text": " Witkoffin oli määrä esitellä tiistaina "
        },
        {
         "number": "11",
         "Text": " Oslossa käydyn Ukraina-kokouksen       "
        },
        {
         "number": "12",
         "Text": " tuloksia.                              "
        },
        {
         "number": "13"
        },
        {
         "number": "14",
         "Text": " Putinin ja Witkoffin tapaaminen kesti  "
        },
        {
         "number": "15",
         "Text": " yli kolme tuntia. Keskusteluiden       "
        },
        {
         "number": "16",
         "Text": " sisällöstä ei heti tuoreeltaan annettu "
        },
        {
         "number": "17",
         "Text": " tietoja. NRK:n mukaan Witkoff          "
        },
        {
         "number": "18",
         "Text": " pistäytyy vielä pikaisesti Oslossa     "
        },
        {
         "number": "19",
         "Text": " ennen kotiinpaluuta.                   "
        },
        {
         "number": "20"
        },
        {
         "number": "21",
         "Text": " Reutersin tietojen mukaan Ukrainan     "
        },
        {
         "number": "22",
         "Text": " delegaatio toi tiistaina pöytään uusia "
        },
        {
         "number": "23",
         "Text": " ehdotuksia ja ajatuksia.               "
        },
        {
         "number": "24"
        }
       ]
      },
