        {
         "number": "2",
         "Text": "       Ilmatieteen laitos               "
        },
        {
         "number": "3",
         "Text": "       Viiden vrk:n sää 22.-26.10.      "
        },
        {
         "number": "4"
        },
        {
         "number": "5"
        },
        {
         "number": "6",
         "Text": " Viiden vuorokauden ennuste ajalle 22.- "
        },
        {
         "number": "7",
         "Text": " 26.10.2026:                            "
        },
        {
         "number": "8"
        },
        {
         "number": "9",
         "Text": " Poutasää jatkuu vielä aluksi. Etenkin  "
        },
        {
         "number": "10",
         "Text": " idässä ja etelässä myös pilvisyys on   "
        },
        {
         "number": "11",
         "Text": " enimmäkseen vähäistä. Paikoin on sumua."
        },
        {
         "number": "12",
         "Text": " Viikonlopun aikana pilvisyys lisääntyy "
        },
        {
         "number": "13",
         "Text": " ja vesi- ja tihkusade yleistyy lännestä"
        },
        {
         "number": "14",
         "Text": " alkaen.                                "
        },
        {
         "number": "15"
        },
        {
         "number": "16",
         "Text": " Päivän ylin lämpötila on maan etelä- ja"
        },
        {
         "number": "17",
         "Text": " keskiosassa 6 ja 12, pohjoisosassa 3 ja"
        },
        {
         "number": "18",
         "Text": " 9 asteen välillä. Yön alin lämpötila on"
        },
        {
         "number": "19",
         "Text": " parina lähiyönä -3 ja +6, viikonloppuna"
        },
        {
         "number": "20",
         "Text": " enimmäkseen +2 ja +9 asteen välillä.   "
        },
        {
         "number": "21"
        },
        {
         "number": "22",
         "Text": " Jakson ennustettu sademäärä on         "
        },
        {
         "number": "23",
         "Text": " enimmäkseen 2-10 mm.                   "
        },
        {
         "number": "24"
        }
       ]
      },
