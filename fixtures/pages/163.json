       "line": [
        {
         "number": "1",
         "Text": "   TALOUS          YLE  KESKIVIIKKO     "
        },
        {
         "number": "2"
        },
        {
         "number": "3",
         "Text": "  Nordea: Käänne asuntomarkkinoille     "
        },
        {
         "number": "4"
        },
        {
         "number": "5"
        },
        {
         "number": "6",
         "Text": " Asuntojen hintojen odotetaan nousevan  "
        },
        {
         "number": "7",
         "Text": " Suomessa prosentilla ensi vuonna,      "
        },
        {
         "number": "8",
         "Text": " Nordea ennustaa                        "
        },
        {
         "number": "9",
         "Text": " asuntomarkkinakatsauksessaan.          "
        },
        {
         "number": "10"
        },
        {
         "number": "11",
         "Text": " Kasvun ennustetaan kiihtyvän 2,5       "
        },
        {
         "number": "12",
         "Text": " prosenttiin vuonna 2028.               "
        },
        {
         "number": "13"
        },
        {
         "number": "14",
         "Text": " Asuntomarkkinoiden käänteen taustalla  "
        },
        {
         "number": "15",
         "Text": " ovat Nordean mukaan hyvät talouskasvu- "
        },
        {
         "number": "16",
         "Text": " ja työllisyyslukemat sekä korkotason   "
        },
        {
         "number": "17",
         "Text": " vakiintuminen.                         "
        },
        {
         "number": "18"
        },
        {
         "number": "19",
         "Text": " Tänä vuonna asuntojen hintojen         "
        },
        {
         "number": "20",
         "Text": " ennustetaan laskevan kolme prosenttia. "
        },
        {
         "number": "21",
         "Text": " Asuntokauppojen määrä on ollut         "
        },
        {
         "number": "22",
         "Text": " tammi-syyskuussa 13 prosenttia         "
        },
        {
         "number": "23",
         "Text": " pienempi vuotta aiempaan verrattuna.   "
        },
        {
         "number": "24"
        }
       ]
      },
