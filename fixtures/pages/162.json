        {
         "number": "1",
         "Text": "   TALOUS          YLE  KESKIVIIKKO     "
        },
        {
         "number": "2"
        },
        {
         "number": "3",
         "Text": "  Musk: Tesla ja SpaceX ehkä yhteen     "
        },
        {
         "number": "4"
        },
        {
         "number": "5"
        },
        {
         "number": "6",
         "Text": " Miljardööri Elon Musk sanoo, että      "
        },
        {
         "number": "7",
         "Text": " avaruusyhtiö SpaceX:n ja auto-         "
        },
        {
         "number": "8",
         "Text": " valmistaja Teslan yhdistyminen olisi   "
        },
        {
         "number": "9",
         "Text": " hyvä idea. Samalla hän paljastaa, että "
        },
        {
         "number": "10",
         "Text": " yhtiöissä on perustettu erityis-       "
        },
        {
         "number": "11",
         "Text": " komiteat, joiden tehtävä on selvittää  "
        },
        {
         "number": "12",
         "Text": " yritysten mahdollista yhdistämistä.    "
        },
        {
         "number": "13"
        },
        {
         "number": "14",
         "Text": " Musk kertoi asiasta samaan aikaan, kun "
        },
        {
         "number": "15",
         "Text": " SpaceX ilmoitti ensimmäisestä vuosi-   "
        },
        {
         "number": "16",
         "Text": " neljänneksen tuloksesta pörssiin       "
        },
        {
         "number": "17",
         "Text": " listautumisensa jälkeen. Yhtiö         "
        },
        {
         "number": "18",
         "Text": " listautui kesäkuussa.                  "
        },
        {
         "number": "19"
        },
        {
         "number": "20",
         "Text": " Yhtiön kokonaistulos oli 4,4 miljardia "
        },
        {
         "number": "21",
         "Text": " dollaria. Yhtiön liikevaihto kasvoi    "
        },
        {
         "number": "22",
         "Text": " 161 prosenttia vuoden takaisesta ja    "
        },
        {
         "number": "23",
         "Text": " oli nyt 14,6 miljardia.                "
        },
        {
         "number": "24"
        }
       ]
      },
