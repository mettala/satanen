       "type": "text",
       "line": [
        {
         "number": "1",
         "Text": "   URHEILUSÄHKEET       LAUANTAI        "
        },
        {
         "number": "2"
        },
        {
         "number": "3",
         "Text": " PESÄPALLO: Naisten Superpesiksen       "
        },
        {
         "number": "4",
         "Text": " kaikkien aikojen lyöjäkuningatar       "
        },
        {
         "number": "5",
         "Text": " Janette Lepistö jatkaa Lapuan Virkiässä"
        },
        {
         "number": "6",
         "Text": " ensi kaudella. Manse PP:n Virpi Hukka  "
        },
        {
         "number": "7",
         "Text": " siirtyy MTV:n tietojen mukaan Porin    "
        },
        {
         "number": "8",
         "Text": " Pesäkarhuihin.                         "
        },
        {
         "number": "9"
        },
        {
         "number": "10",
         "Text": " AM.JALKAPALLO: Suomi voitti Vantaalla  "
        },
        {
         "number": "11",
         "Text": " Ison-Britannian 21-0 EM-lohkopelissään "
        },
        {
         "number": "12",
         "Text": " ja varmisti paikan vuonna 2027         "
        },
        {
         "number": "13",
         "Text": " pelattaviin neljän maan mitalipeleihin."
        },
        {
         "number": "14"
        },
        {
         "number": "15",
         "Text": " JALKAPALLO: Hyökkääjä David Ezeh on    "
        },
        {
         "number": "16",
         "Text": " tehnyt kolmivuotisen sopimuksen Kuopion"
        },
        {
         "number": "17",
         "Text": " Palloseuran kanssa. Ezeh siirtyy       "
        },
        {
         "number": "18",
         "Text": " Kuopioon kauden 2026 jälkeen. Ezeh, 20,"
        },
        {
         "number": "19",
         "Text": " on pelannut HJK:ssa 13-vuotiaasta.     "
        },
        {
         "number": "20",
         "Text": " Hänen kautensa 2026 päättyi kesäkuussa "
        },
        {
         "number": "21",
         "Text": " lonkkamurtumaan ja leikkaukseen.       "
        },
        {
         "number": "22"
        },
        {
         "number": "23"
        },
        {
         "number": "24"
        }
       ]
      },
