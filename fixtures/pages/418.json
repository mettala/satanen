        {
         "number": "4"
        },
        {
         "number": "5",
         "Text": " Siitepölykausi on                      "
        },
        {
         "number": "6",
         "Text": " päättynyt.                             "
        },
        {
         "number": "7"
        },
        {
         "number": "8",
         "Text": " Cladosporium- ja Alternaria-           "
        },
        {
         "number": "9",
         "Text": " homesienen itiömäärä vähäi-            "
        },
        {
         "number": "10",
         "Text": " nen, lämpiminä päivinä voi             "
        },
        {
         "number": "11",
         "Text": " hetkellisesti nousta kohta-            "
        },
        {
         "number": "12",
         "Text": " laiseksi. Pitoisuudet laske-           "
        },
        {
         "number": "13",
         "Text": " vat nollaan vasta yöpakkas-            "
        },
        {
         "number": "14",
         "Text": " ten yleistyttyä ja lumi-               "
        },
        {
         "number": "15",
         "Text": " peitteen tultua maahan.                "
        },
        {
         "number": "16"
        },
        {
         "number": "17",
         "Text": " Uusi siitepölykausi                    "
        },
        {
         "number": "18",
         "Text": " alkaa tavallisesti                     "
        },
        {
         "number": "19",
         "Text": " tammi-helmikuussa päh-                 "
        },
        {
         "number": "20",
         "Text": " kinäpensaan ja lepän                   "
        },
        {
         "number": "21",
         "Text": " siitepölyn kulkeutumil-                "
        },
        {
         "number": "22",
         "Text": "                    la.                 "
        },
        {
         "number": "23",
         "Text": "   Aerobiologian yksikkö,Turun yliopisto"
        },
        {
         "number": "24"
        }
       ]
