        {
         "number": "1",
         "Text": "   KOTIMAA         YLE  KESKIVIIKKO     "
        },
        {
         "number": "2"
        },
        {
         "number": "3",
         "Text": "  Verkkopalveluja ajetaan alas          "
        },
        {
         "number": "4"
        },
        {
         "number": "5"
        },
        {
         "number": "6",
         "Text": " Valtion tieto- ja                      "
        },
        {
         "number": "7",
         "Text": " viestintätekniikkakeskus Valtori       "
        },
        {
         "number": "8",
         "Text": " kertoo, että se ajaa varotoimena alas  "
        },
        {
         "number": "9",
         "Text": " valtionhallinnon julkisen internetin   "
        },
        {
         "number": "10",
         "Text": " verkkopalveluja.                       "
        },
        {
         "number": "11"
        },
        {
         "number": "12",
         "Text": " Taustalla on laajasti käytössä         "
        },
        {
         "number": "13",
         "Text": " olevasta PHP-ohjelmistosta löydetyt    "
        },
        {
         "number": "14",
         "Text": " kriittiset haavoittuvuudet.            "
        },
        {
         "number": "15"
        },
        {
         "number": "16",
         "Text": " Käyttökatko ei johdu haavoittuvuuden   "
        },
        {
         "number": "17",
         "Text": " hyväksikäytöstä eikä palveluihin       "
        },
        {
         "number": "18",
         "Text": " kohdistuneesta tietomurrosta, vaan     "
        },
        {
         "number": "19",
         "Text": " tarkoitus on suojata palveluita.       "
        },
        {
         "number": "20"
        },
        {
         "number": "21",
         "Text": " Haavoittuvuuksia korjaava päivitys on  "
        },
        {
         "number": "22",
         "Text": " valmistajan mukaan tulossa saataville  "
        },
        {
         "number": "23",
         "Text": " kello 17.                              "
        },
        {
         "number": "24"
        }
       ]
      },
