       "line": [
        {
         "number": "1",
         "Text": "   HUVUDSTADSREGIONEN      ONSDAG   1/3 "
        },
        {
         "number": "2",
         "Text": " Så här ska Helsingfors rädda fiskarna i"
        },
        {
         "number": "3",
         "Text": " Gammelstadsforsen                      "
        },
        {
         "number": "4",
         "Text": " Gammelstadsforsens framtid har         "
        },
        {
         "number": "5",
         "Text": " diskuterats i många år. Nu har         "
        },
        {
         "number": "6",
         "Text": " Helsingfors stad utrett det bästa      "
        },
        {
         "number": "7",
         "Text": " alternativet för forsen.               "
        },
        {
         "number": "8",
         "Text": " Nu har Helsingfors stad utrett vad som "
        },
        {
         "number": "9",
         "Text": " kan tänkas vara den bästa lösningen för"
        },
        {
         "number": "10",
         "Text": " Gammelstadsforsen.                     "
        },
        {
         "number": "11",
         "Text": " I den södra ändan av Vanda å, där ån   "
        },
        {
         "number": "12",
         "Text": " rinner ut i Gammelstadsfjärden och     "
        },
        {
         "number": "13",
         "Text": " Finska viken, finns en fors med två    "
        },
        {
         "number": "14",
         "Text": " fåror – den västra och den östra – och "
        },
        {
         "number": "15",
         "Text": " en damm.                               "
        },
        {
         "number": "16",
         "Text": " Dammen och den västra fåran har i många"
        },
        {
         "number": "17",
         "Text": " år ansetts vara ett hinder för         "
        },
        {
         "number": "18",
         "Text": " vandringsfiskar att vandra upp för     "
        },
        {
         "number": "19",
         "Text": " Vanda å, och en rivning har ansetts    "
        },
        {
         "number": "20",
         "Text": " gynna fiskbeståndet.                   "
        },
        {
         "number": "21"
        },
        {
         "number": "22"
        },
        {
         "number": "23",
         "Text": "      svenska.yle.fi/huvudstadsregionen "
        },
        {
         "number": "24"
        }
       ]
      },
