     "content": [
      {
       "type": "text",
       "line": [
        {
         "number": "1",
         "Text": "   HUVUDSTADSREGIONEN      ONSDAG   2/3 "
        },
        {
         "number": "2",
         "Text": " Många elever hastar igenom lunchen på  "
        },
        {
         "number": "3",
         "Text": " 20 minuter                             "
        },
        {
         "number": "4",
         "Text": " Flera skolor har lunchpauser som är    "
        },
        {
         "number": "5",
         "Text": " klart kortare än vad myndigheter       "
        },
        {
         "number": "6",
         "Text": " rekommenderar.                         "
        },
        {
         "number": "7",
         "Text": " Minst 30 minuter. Det är den tid       "
        },
        {
         "number": "8",
         "Text": " Statens näringsdelegation rekommenderar"
        },
        {
         "number": "9",
         "Text": " att skolbarn ska ha på sig för sin     "
        },
        {
         "number": "10",
         "Text": " lunch.                                 "
        },
        {
         "number": "11",
         "Text": " Så är ändå inte fallet i alla skolor i "
        },
        {
         "number": "12",
         "Text": " Helsingfors.                           "
        },
        {
         "number": "13",
         "Text": " Bland annat har eleverna i Nordsjö     "
        },
        {
         "number": "14",
         "Text": " lågstadieskola bara 20 minuter på sig  "
        },
        {
         "number": "15",
         "Text": " för lunchen. Klasserna äter i tre turer"
        },
        {
         "number": "16",
         "Text": " mellan klockan 11 och 12.              "
        },
        {
         "number": "17",
         "Text": " Också i Botby grundskola är tiden      "
        },
        {
         "number": "18",
         "Text": " kortare än rekommenderat. Där äter     "
        },
        {
         "number": "19",
         "Text": " eleverna i två turer mellan 11 och     "
        },
        {
         "number": "20",
         "Text": " 11.45. Det betyder att eleverna har    "
        },
        {
         "number": "21",
         "Text": " 20–25 minuter på sig att äta lunch.    "
        },
        {
         "number": "22"
        },
        {
         "number": "23",
         "Text": "      svenska.yle.fi/huvudstadsregionen "
        },
        {
         "number": "24"
        }
       ]
      },
