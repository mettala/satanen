        {
         "number": "1",
         "Text": "   JÄÄKIEKKO          KESKIVIIKKO       "
        },
        {
         "number": "2"
        },
        {
         "number": "3",
         "Text": "  Olli Jokinen sai lähteä HIFK:sta      "
        },
        {
         "number": "4"
        },
        {
         "number": "5"
        },
        {
         "number": "6",
         "Text": " Miesten jääkiekkoliigajoukkue HIFK on  "
        },
        {
         "number": "7",
         "Text": " antanut potkut päävalmentajalleen Olli "
        },
        {
         "number": "8",
         "Text": " Jokiselle. Jokinen oli valmentanut     "
        },
        {
         "number": "9",
         "Text": " joukkuetta kaudesta 2025-26 lähtien.   "
        },
        {
         "number": "10",
         "Text": " HIFK on tällä hetkellä liigassa        "
        },
        {
         "number": "11",
         "Text": " kolmanneksi viimeisellä sijalla.       "
        },
        {
         "number": "12"
        },
        {
         "number": "13",
         "Text": " Jokisen korvaa Tommi Miettinen, 50. Hän"
        },
        {
         "number": "14",
         "Text": " on aiemmin toiminut KalPan ja TPS:n    "
        },
        {
         "number": "15",
         "Text": " liigajoukkueiden valmentajana. Muu     "
        },
        {
         "number": "16",
         "Text": " valmennusryhmä julkaistaan myöhemmin.  "
        },
        {
         "number": "17"
        },
        {
         "number": "18",
         "Text": " - Päätös valmennuksen vaihtamiseen     "
        },
        {
         "number": "19",
         "Text": " perustuu täysin urheilullisuuteen.     "
        },
        {
         "number": "20",
         "Text": " Minun tuli tehdä ratkaisu ennen kuin   "
        },
        {
         "number": "21",
         "Text": " erot muihin joukkueisiin kasvavat      "
        },
        {
         "number": "22",
         "Text": " liian suuriksi, urheilujohtaja Janne   "
        },
        {
         "number": "23",
         "Text": " Laukkanen sanoi seuran tiedotteessa.   "
        },
        {
         "number": "24"
        }
       ]
      },
