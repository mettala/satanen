     "content": [
      {
       "type": "text",
       "line": [
        {
         "number": "1",
         "Text": "   Helsingin Pörssi 21.10. 18:34        "
        },
        {
         "number": "2",
         "Text": " Pörssisivuilla nousevien kurssien      "
        },
        {
         "number": "3",
         "Text": " muutosprosenttia merkitään keltaisella "
        },
        {
         "number": "4",
         "Text": " ja laskevien sinisellä.                "
        },
        {
         "number": "5"
        },
        {
         "number": "6",
         "Text": " Sivuilla käytetään seuraavia lyhenteitä"
        },
        {
         "number": "7",
         "Text": "   T  - tuhat                           "
        },
        {
         "number": "8",
         "Text": "   M  - miljoona                        "
        },
        {
         "number": "9",
         "Text": "   KK - tuotteen päättymiskuukausi      "
        },
        {
         "number": "10",
         "Text": "   TH - tuotteen toteutushinta          "
        },
        {
         "number": "11"
        },
        {
         "number": "12",
         "Text": " (T) nimen perässä merkitsee osakkeen   "
        },
        {
         "number": "13",
         "Text": " olevan tarkkailulistalla.              "
        },
        {
         "number": "14",
         "Text": " (S) nimen perässä merkitsee osakkeen   "
        },
        {
         "number": "15",
         "Text": " olevan senttiosake.                    "
        },
        {
         "number": "16"
        },
        {
         "number": "17",
         "Text": " Rahastosivuilla PV-sarake kertoo       "
        },
        {
         "number": "18",
         "Text": " tietojen päivityspäivän. Muut tiedot   "
        },
        {
         "number": "19",
         "Text": " ovat n. 20 min viivästettyjä. Sivujen  "
        },
        {
         "number": "20",
         "Text": " päivitysväli riippuu kaupankäynnin     "
        },
        {
         "number": "21",
         "Text": " aktiivisuudesta.                       "
        },
        {
         "number": "22"
        },
        {
         "number": "23",
         "Text": "         OMXH 13 206,91  ( +0,64 )      "
        },
        {
         "number": "24"
        }
       ]
      },
