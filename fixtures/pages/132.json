         "number": "1",
         "Text": "   ULKOMAAT        YLE  KESKIVIIKKO     "
        },
        {
         "number": "2"
        },
        {
         "number": "3",
         "Text": "  WSJ: Musk määräsi Starlink-verkosta   "
        },
        {
         "number": "4"
        },
        {
         "number": "5"
        },
        {
         "number": "6",
         "Text": " Avaruusyhtiö SpaceX:n toimitusjohtaja  "
        },
        {
         "number": "7",
         "Text": " Elon Musk käski hidastaa Ukrainan      "
        },
        {
         "number": "8",
         "Text": " käyttämän satelliittipalvelu           "
        },
        {
         "number": "9",
         "Text": " Starlinkin sotilasversiota. Asiasta    "
        },
        {
         "number": "10",
         "Text": " kertoo lähteisiinsä viitaten Wall      "
        },
        {
         "number": "11",
         "Text": " Street Journal -lehti.                 "
        },
        {
         "number": "12"
        },
        {
         "number": "13",
         "Text": " Käytännössä tämä tarkoitti sitä, että  "
        },
        {
         "number": "14",
         "Text": " Ukraina ei viime viikolla pystynyt     "
        },
        {
         "number": "15",
         "Text": " käyttämään torjuntajärjestelmiään      "
        },
        {
         "number": "16",
         "Text": " Venäjän drooni-iskuja vastaan.         "
        },
        {
         "number": "17"
        },
        {
         "number": "18",
         "Text": " Starlinkin hidastaminen aiheutti       "
        },
        {
         "number": "19",
         "Text": " suurta vahinkoa Ukrainassa ja          "
        },
        {
         "number": "20",
         "Text": " hämmennystä Yhdysvaltain hallinnon     "
        },
        {
         "number": "21",
         "Text": " sisällä. Hallinto on kiistänyt         "
        },
        {
         "number": "22",
         "Text": " osallisuutensa Starlinkin hidasteluun. "
        },
        {
         "number": "23"
        },
        {
         "number": "24"
        }
       ]
