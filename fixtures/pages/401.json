        },
        {
         "number": "2",
         "Text": "            Ilmatieteen laitos 21.10.   "
        },
        {
         "number": "3",
         "Text": "            Säätiedotus klo 22          "
        },
        {
         "number": "4"
        },
        {
         "number": "5"
        },
        {
         "number": "6",
         "Text": " Sää on poutainen suuressa osassa maata,"
        },
        {
         "number": "7",
         "Text": " laajalti myös selkeä. Yöllä ja aamulla "
        },
        {
         "number": "8",
         "Text": " muodostuu monin paikoin sumua, joka    "
        },
        {
         "number": "9",
         "Text": " haihtuu suurelta osin aamupäivän       "
        },
        {
         "number": "10",
         "Text": " aikana.                                "
        },
        {
         "number": "11"
        },
        {
         "number": "12",
         "Text": " Odotettavissa huomiseen iltaan asti:   "
        },
        {
         "number": "13"
        },
        {
         "number": "14",
         "Text": " Maan etelä- ja keskiosassa: Enimmäkseen"
        },
        {
         "number": "15",
         "Text": " selkeää tai puolipilvistä. Poutaa.     "
        },
        {
         "number": "16",
         "Text": " Yöstä alkaen monin paikoin sumua.      "
        },
        {
         "number": "17",
         "Text": " Päivällä vaihtelevaa pilvisyyttä. Yön  "
        },
        {
         "number": "18",
         "Text": " alin lämpötila on -1...+5, idässä      "
        },
        {
         "number": "19",
         "Text": " +1...-3 astetta. Päivän ylin 7...12    "
        },
        {
         "number": "20",
         "Text": " astetta. Heikkoa tai kohtalaista       "
        },
        {
         "number": "21",
         "Text": " kaakkoistuulta.                        "
        },
        {
         "number": "22"
        },
        {
         "number": "23"
        },
        {
         "number": "24"
        }
