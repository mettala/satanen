         "Text": " tai kohtalaista etelänpuoleista tuulta."
        },
        {
         "number": "14"
        },
        {
         "number": "15",
         "Text": " Liikennesää pääteillä lähivuorokauden  "
        },
        {
         "number": "16",
         "Text": " aikana: Ajokeli on huono maan          "
        },
        {
         "number": "17",
         "Text": " pohjoisosassa sekä Etelä-Karjalan,     "
        },
        {
         "number": "18",
         "Text": " Keski-Suomen, Etelä-Savon, Pohjois-    "
        },
        {
         "number": "19",
         "Text": " Savon, Pohjois-Karjalan ja Keski-      "
        },
        {
         "number": "20",
