        {
         "number": "1",
         "Text": "   KOTIMAA         YLE  KESKIVIIKKO     "
        },
        {
         "number": "2"
        },
        {
         "number": "3",
         "Text": "  Epäily: Jyväskylän palo tahallinen    "
        },
        {
         "number": "4"
        },
        {
         "number": "5"
        },
        {
         "number": "6",
         "Text": " Poliisi epäilee, että eilen            "
        },
        {
         "number": "7",
         "Text": " Jyväskylässä Hämeenkadulla syttynyt    "
        },
        {
         "number": "8",
         "Text": " tulipalo on sytetytty tahallisesti.    "
        },
        {
         "number": "9"
        },
        {
         "number": "10",
         "Text": " Sisä-Suomen poliisi tukii asiaa tällä  "
        },
        {
         "number": "11",
         "Text": " hetkellä törkeänä tuhotyönä sekä       "
        },
        {
         "number": "12",
         "Text": " törkeänä kuolemantuottamuksena.        "
        },
        {
         "number": "13",
         "Text": " Rikoksesta epäillään noin 30-vuotiasta "
        },
        {
         "number": "14",
         "Text": " asunnossa asunutta naista.             "
        },
        {
         "number": "15"
        },
        {
         "number": "16",
         "Text": " Poliisi on aloittanut esitutkinnan ja  "
        },
        {
         "number": "17",
         "Text": " jatkaa sekä palon syttymissyyn että    "
        },
        {
         "number": "18",
         "Text": " teon motiivin selvittämistä.           "
        },
        {
         "number": "19"
        },
        {
         "number": "20",
         "Text": " Palossa kuoli noin 30-vuotias talossa  "
        },
        {
         "number": "21",
         "Text": " asunut mies.                           "
        },
        {
         "number": "22"
        },
        {
         "number": "23"
        },
        {
         "number": "24"
        }
       ]
