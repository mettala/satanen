{
  "name": "satanen",
  "version": "1.0.0",
  "license": "MIT",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "fetch-fixtures": "node --no-warnings --env-file-if-exists=.env.fixtures scripts/fetch-fixtures.ts",
    "tokens": "node scripts/generate-tokens.mts",
    "section-map": "node --no-warnings --experimental-strip-types --experimental-loader ./scripts/ts-loader.mjs scripts/build-section-map.mts",
    "parser-report": "node --no-warnings --experimental-strip-types --experimental-loader ./scripts/ts-loader.mjs scripts/parser-report.mts",
    "fixture-index": "node --no-warnings --experimental-strip-types scripts/build-fixture-index.mts",
    "build:web": "NO_DEV_ROUTES=1 expo export --platform web --clear && node --no-warnings --experimental-strip-types scripts/build-sw.mts && node scripts/write-version.mjs && node scripts/check-dist.mjs",
    "deploy:web": "node scripts/assert-release.mjs && EXPO_PUBLIC_PROXY_URL=https://api.satanen.io npm run build:web && node scripts/deploy.mjs web",
    "smoke:web": "node scripts/smoke-web.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/schibsted-grotesk": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-font": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
