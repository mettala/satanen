/**
 * Writes src/dev/fixtures.generated.ts: one `require` per fixture page and
 * image, so Metro bundles them for the dev preview screen (/dev/preview).
 * Run with `npm run fixture-index` after adding fixtures.
 */
import { readdirSync, writeFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { fileURLToPath } from 'node:url';

const root = fileURLToPath(new URL('..', import.meta.url));
const nums = (dir: string, ext: string) =>
  readdirSync(resolve(root, 'fixtures', dir))
    .filter((f) => f.endsWith(ext) && /^\d+$/.test(f.slice(0, -ext.length)))
    .map((f) => Number.parseInt(f, 10))
    .sort((a, b) => a - b);

const pages = nums('pages', '.json');
const images = new Set(nums('images', '.png'));

const entries = pages
  .map((n) => {
    const image = images.has(n) ? `, image: require('../../fixtures/images/${n}.png')` : '';
    return `  { page: ${n}, raw: require('../../fixtures/pages/${n}.json')${image} },`;
  })
  .join('\n');

const out = `// @generated by scripts/build-fixture-index.mts, do not edit.
// Fixture pages and Yle's page images, for the dev preview screen only.

export interface FixtureEntry {
  page: number;
  raw: unknown;
  /** Yle's own page image (a Metro asset id); missing for a few pages. */
  image?: number;
}

export const fixtureEntries: FixtureEntry[] = [
${entries}
];
`;
writeFileSync(resolve(root, 'src', 'dev', 'fixtures.generated.ts'), out);
console.log(`Wrote src/dev/fixtures.generated.ts (${pages.length} pages)`);
